<UserControl x:Class="RomForge.Controls.Switch.RenameTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:core="clr-namespace:NSW.WPF.UI;assembly=NSW.WPF" 
             xmlns:l="clr-namespace:NSW.Core.Properties;assembly=NSW.Core" 
             xmlns:local="clr-namespace:RomForge.Controls.Switch"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <core:FileManagerControl x:Name="fileMgr" Grid.Row="0" Margin="5,0,5,5" IsEnabled="{Binding IsIdle}"/>

        <Border Grid.Row="1" Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Margin="5,0,5,5" Padding="10,8" IsEnabled="{Binding IsIdle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="파일명 포맷:" Foreground="White" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding NamingPresets}" SelectedItem="{Binding SelectedNamingPreset, Mode=TwoWay}" Height="30" FontSize="12" Margin="0,0,4,0">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Height" Value="9"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Name}"/>
                                    <Border Height="1" Background="Gray" VerticalAlignment="Center" Margin="4,0" Visibility="Collapsed">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Grid.Column="2" x:Name="txtFormat" Text="{Binding FormatText, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsFormatReadOnly, Mode=OneWay}" TextChanged="TxtFormat_TextChanged" ToolTip="{}{Name}: 한글 + 영어 제목 (병합 파일명과 동일)&#10;{KTitleName}: 한글 제목&#10;{TitleName}: 한글 → 영어 → 첫 번째 제목 순&#10;{TitleID}: 타이틀 ID&#10;{Tag}: 구성 (B+U+10D)&#10;{DisplayVersion}: 표시 버전 (1.0.0)&#10;{Version}: 버전 (65536)" Background="#12FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1" Foreground="#DCDCDC" CaretBrush="White" FontSize="12" Height="30" VerticalContentAlignment="Center" Padding="8,0"/>
                </Grid>
                <TextBlock Text="사용 가능한 항목: {Name}  {KTitleName}  {TitleName}  {TitleID}  {Tag}  {DisplayVersion}  {Version}  (확장자는 자동으로 유지됩니다)" Foreground="Gray" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="8" Background="#12FFFFFF" Margin="5,0,5,5" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListView Grid.Row="0" x:Name="lvPreview" Height="120" ItemsSource="{Binding PreviewItems}" SelectionMode="Single">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="상태" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="현재 이름" Width="320">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OldName}" ToolTip="{Binding FilePath}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="변경 후 이름" Width="320">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NewName}" ToolTip="{Binding NewName}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock Grid.Row="1" Text="{Binding Summary}" Foreground="#A0A0A0" FontSize="11" Margin="2,6,0,0"/>
            </Grid>
        </Border>

        <core:IconButton Grid.Row="3" x:Name="btnStartWork" Margin="5,0,5,5" DefaultText="이름 변경" DefaultIcon="/Assets/Images/Rename.png" CancelText="{x:Static l:Resources.Button_Cancel}" CancelIcon="/Assets/Images/Cancel.png" IsRunning="{Binding IsLocked}"
            Click="BtnStartWork_Click"/>
    </Grid>
</UserControl>
